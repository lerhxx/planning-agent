{
  "name": "planning-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:comments": "node scripts/check-comment-terminators.mjs",
    "lint": "node scripts/check-comment-terminators.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:commit-prefix": "bash scripts/check-commit-prefix.sh",
    "segment-lines": "bash scripts/segment-lines.sh"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@copilotkit/react-core": "1.77.0",
    "@mastra/core": "1.74.0",
    "next": "16.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
