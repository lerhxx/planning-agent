# ─────────────────────────────────────────────────────────────────────────────
# 环境变量样例。复制成 .env.local 并填入真实值（.env / .env.local 已被 .gitignore 忽略）。
#
# ★ 只有两种运行模式，由下面第 1 个变量决定：
#
#   1) mock（默认）—— 不发任何网络请求、不需要密钥，行为由脚本 fixtures 决定。
#      适合本地开发、跑测试、演示"确定性重规划"。
#
#   2) mastra —— 真正调模型。必须配齐第 2~5 节，缺任意一个都会**启动即报错**
#      （MissingModelConfigError），**不会**悄悄退回 mock。
#      这是刻意的：悄悄退回脚本数据、让用户以为在跑真模型，是欺骗性降级。
#
#   单次请求也可以用 realModel: true 显式开启真模型（见 README / v3 架构文档 §7）。
# ─────────────────────────────────────────────────────────────────────────────


# ── ① 选模式 ──────────────────────────────────────────────────────────────────
# 不设置 = mock。设为 mastra 才走真模型。
# 也可以不设它、只在单次请求里传 realModel: true。
RUNTIME_ADAPTER=mock


# ── ② 文本模型（规划 / 重规划用，必填）────────────────────────────────────────
# 模型 id 由「provider + 斜杠 + model」拼成。
# ★ Mastra 的 id 是模板字面量类型，强制含斜杠：写 qwen-max 会编译报错，
#   必须写成 dashscope/qwen-max 这种形式 —— 斜杠是代码拼的，你只填两段。
MASTRA_TEXT_PROVIDER=dashscope
MASTRA_TEXT_MODEL=qwen-max
# OpenAI 兼容端点。国产三家都提供：
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   豆包      https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek  https://api.deepseek.com/v1
MASTRA_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MASTRA_TEXT_API_KEY=sk-填你的密钥


# ── ③ 视觉模型（识别上传的图片用）─────────────────────────────────────────────
# ⚠️ 当前**没有任何代码会读这四个变量** —— visionModel() 已实现但还没有调用方
#    （多模态链路属 v3 范围外，见架构文档 §10.3 的 U5）。先写在这里是因为
#    接线时不用再回来查变量名。填了也不会报错，但也不起作用。
MASTRA_VISION_PROVIDER=dashscope
MASTRA_VISION_MODEL=qwen-vl-max
MASTRA_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MASTRA_VISION_API_KEY=sk-填你的密钥


# ── ④ 密钥安全红线 ────────────────────────────────────────────────────────────
# ★ 绝对不要给密钥加 NEXT_PUBLIC_ 前缀 —— 那会被打进客户端 bundle 并公开。
#   本仓已有一条自动化守卫拦这个（src/test/mastraBoundary.test.ts）。
# ★ 密钥只在服务端被读取：app/api → runtime/factory → runtime/mastra/models.ts。
